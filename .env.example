DISCORD_BOT_TOKEN=your_token_here
CLIENT_ID=your_application_client_id_here

# High-availability: private channel visible only to the bot (used for state sync between nodes)
# Create a private channel, invite the bot, and paste its ID here.
# All friends running the bot must use the same channel ID.
COORDINATION_CHANNEL_ID=

# Auto-event scheduler
AUTO_EVENT_ENABLED=true
AUTO_EVENT_CHANNEL_ID=1501286843440959608
AUTO_EVENT_SCHEDULE=21:30
AUTO_EVENT_TITLE=Guild Raid Signup
AUTO_EVENT_DESCRIPTION=React to join your pool for today's raid
AUTO_EVENT_MAINBALL_MAX=20
AUTO_EVENT_DEF_TEAM_MAX=10
AUTO_EVENT_COMMANDER_MAX=2
AUTO_EVENT_SHAI_MAX=3
AUTO_EVENT_FLEX_MAX=5

# Pool emojis
MAINBALL_EMOJI=⚔️
DEF_TEAM_EMOJI=🛡️
COMMANDER_EMOJI=👑
SHAI_EMOJI=🎵
FLEX_EMOJI=🔄
DONKEY_EMOJI=🐴
